@@ -0,0 +1,53 @@
+import { readFileSync, writeFileSync } from "node:fs";
+import { test } from "vitest";
+import {
+    assessChessDecision,
+    type DecisionAssessmentInput,
+} from "../tacticalMotifs/decisionAssessment";
+import { findOpenedRookFile } from "../tacticalMotifs/decisionOpenedRookFile";
+import { buildLiveTacticalScan } from "../tacticalMotifs/liveTactics";
+
+type Case = DecisionAssessmentInput & { id: string; label?: unknown };
+const input = process.env.DECISION_OPEN_FILE_INPUT;
+const output = process.env.DECISION_OPEN_FILE_OUTPUT;
+
+test.runIf(input && output)(
+    "compares corroborated rook-file activity using the same engine frames",
+    () => {
+        const cases = JSON.parse(readFileSync(input!, "utf8")) as Case[];
+        const report = cases.map(({ id, label, ...row }) => {
+            const best = row.candidates[0];
+            const scan = buildLiveTacticalScan({
+                fen: row.fen,
+                pvUci: best.pvUci,
+                depth: best.depth,
+                engineName: "Stockfish 19",
+                variations: row.candidates,
+            });
+            const baseline = assessChessDecision({
+                ...row,
+                rootCertificates: scan.variations.map((variation) => ({
+                    fen: row.fen,
+                    moveUci: variation.lineUci[0],
+                    motifs: variation.motifs,
+                })),
+            });
+            const start = performance.now();
+            const attempts = (
+                ["root-only", "reply-aware", "anchored", "contested", "demonstrated"] as const
+            ).map((mode) => [
+                mode,
+                findOpenedRookFile(row.fen, row.candidates, row.replyProbes ?? [], mode),
+            ]);
+            return {
+                id,
+                label,
+                baseline,
+                plans: Object.fromEntries(attempts),
+                ms: performance.now() - start,
+            };
+        });
+        writeFileSync(output!, JSON.stringify(report), { flag: "wx" });
+    },
+    180_000,
+);
