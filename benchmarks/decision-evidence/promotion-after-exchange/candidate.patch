diff --git a/src/utils/tests/decisionExchangePasser.test.ts b/src/utils/tests/decisionExchangePasser.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..70ce8d816ede3fa86d970a2d4ea947f310370631
--- /dev/null
+++ b/src/utils/tests/decisionExchangePasser.test.ts
@@ -0,0 +1,67 @@
+import { expect, test } from "vitest";
+import { assessChessDecision } from "../tacticalMotifs/decisionAssessment";
+import { findExchangePasser, nominateExchangePasserCaptures } from "../tacticalMotifs/decisionExchangePasser";
+
+const fen = "b4bk1/2r1np2/1q2p1p1/4P1Qp/3P4/1p2R1PP/1B1N1P2/1B4K1 b - - 1 36";
+const replyFen = "b4bk1/4np2/1q2p1p1/4P1Qp/3P4/1p2R1PP/1BrN1P2/1B4K1 w - - 2 37";
+const best = {
+    fen: replyFen,
+    depth: 17,
+    cp: -337,
+    pvUci: "b1c2 b3c2 e3b3 b6d4 b2c1 d4a1 d2f3 e7f5 f3e1".split(" "),
+};
+const root = { fen, depth: 21, cp: 444, pvUci: ["c7c2", ...best.pvUci] };
+const other = { fen, depth: 21, cp: 77, pvUci: "c7c8 e3b3 b6a5 g5e3 a8d5 b3c3 c8b8 b2a3 f8h6".split(" ") };
+const weaker = { ...best, cp: -685, pvUci: "e3b3 c2d2 g5d2 b6b3 d2e2 h5h4 b1d3 h4g3".split(" ") };
+
+const assess = (replies = [best, weaker]) =>
+    assessChessDecision({
+        fen,
+        candidates: [root, other],
+        replyProbes: [{ moveUci: "c7c2", lines: replies }],
+    });
+
+test("traces the same passer through a rook offer and verifies the pawn-capture consequence separately", () => {
+    const report = assess();
+    expect(report?.moves[0]).toMatchObject({
+        category: "mixed",
+        tactical: { support: "supported", basis: "engine-supported" },
+        positional: { support: "supported", basis: "heuristic" },
+        exchangePasser: { pawnFrom: "b3", pawnTo: "c2", promotionSquare: "c1", materialBalancePoints: -1.7 },
+    });
+    expect(report?.moves[0].exchangePasser?.pawnCapture).toMatchObject({
+        replySan: "Rxb3",
+        lineUci: ["c7c2", "e3b3", "c2d2", "g5d2", "b6b3", "d2e2", "h5h4"],
+    });
+    expect(report?.position.category).toBe("mixed");
+});
+
+test("keeps the structural evidence when a searched pawn-capture reply is unavailable", () => {
+    const move = assess([best])?.moves[0];
+    expect(move?.positional.support).toBe("supported");
+    expect(move?.exchangePasser).toBeDefined();
+    expect(move?.exchangePasser?.pawnCapture).toBeUndefined();
+    expect(move?.tactical.support).not.toBe("supported");
+});
+
+test("requires the same traded pieces and an actual blockade in both searches", () => {
+    const displaced = { ...best, pvUci: "b1c2 b3c2 e3b3 b6d4 b2a3 e7f5 a3c1 d4d5".split(" ") };
+    expect(findExchangePasser(fen, root, [root, other], [displaced])).toBeNull();
+    const secondReply = { ...weaker, cp: best.cp };
+    expect(findExchangePasser(fen, root, [root, other], [secondReply])).toBeNull();
+});
+
+test("requires the pawn advance to distinguish two comparable searches", () => {
+    expect(findExchangePasser(fen, root, [root, { ...other, cp: 330 }], [best])).toBeNull();
+    expect(findExchangePasser(fen, root, [root], [best])).toBeNull();
+    expect(findExchangePasser(fen, root, [root, { ...other, depth: 18 }], [best])).toBeNull();
+});
+
+test("nominates only unsearched legal captures after establishing the exchange", () => {
+    expect(nominateExchangePasserCaptures(fen, [root, other], [best]).sort()).toEqual(["d2b3", "e3b3"]);
+    expect(nominateExchangePasserCaptures(fen, [root, other], [best, weaker])).toEqual([]);
+    expect(nominateExchangePasserCaptures(fen, [root, other], [weaker])).toEqual([]);
+    const targeted = { ...weaker, depth: 28, cp: -720 };
+    expect(findExchangePasser(fen, root, [root, other], [best], [targeted])?.pawnCapture?.replySan).toBe("Rxb3");
+    expect(findExchangePasser(fen, root, [root, other], [best], [{ ...targeted, fen }])?.pawnCapture).toBeUndefined();
+});
