diff --git a/src/utils/tacticalMotifs/decisionExchangePasser.ts b/src/utils/tacticalMotifs/decisionExchangePasser.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dc8a7fcba62150bb97cf5bd9fee35021bf7ffb98
--- /dev/null
+++ b/src/utils/tacticalMotifs/decisionExchangePasser.ts
@@ -0,0 +1,220 @@
+import { makeFen } from "chessops/fen";
+import type { Color, Square } from "chessops/types";
+import { makeSquare, makeUci, opposite, parseSquare } from "chessops/util";
+import { replayTacticalLine, type TacticalReplayStep } from "./causalTactics";
+import { measureDecisionLine, type DecisionEngineLine } from "./decisionEvidence";
+import type { ComparativePositionalEvidence } from "./positionalTransitions";
+
+const HORIZON = 9;
+const rank = (square: Square, side: Color) =>
+    side === "white" ? 1 + (square >> 3) : 8 - (square >> 3);
+
+export type ExchangePasserEvidence = {
+    fen: string;
+    factor: ComparativePositionalEvidence;
+    pawnFrom: string;
+    pawnTo: string;
+    promotionSquare: string;
+    materialBalancePoints: number;
+    principalLineUci: string[];
+    alternativeLineUci: string[];
+    pawnCapture?: { replySan: string; lineUci: string[]; description: string };
+};
+
+function passed(step: TacticalReplayStep, square: Square, side: Color) {
+    return ![...step.after.board.pawn.intersect(step.after.board[opposite(side)])].some(
+        pawn => Math.abs((pawn & 7) - (square & 7)) <= 1 && rank(pawn, side) > rank(square, side),
+    );
+}
+
+function blockadedPasser(steps: TacticalReplayStep[], square: Square, side: Color) {
+    const promotionSquare = square + (side === "white" ? 8 : -8);
+    let blockadePly = 0;
+    let through = 0;
+    for (const [index, step] of steps.entries()) {
+        if (index < 2) continue;
+        const pawn = step.after.board.get(square);
+        if (pawn?.color !== side || pawn.role !== "pawn" || !passed(step, square, side)) break;
+        if (!blockadePly &&
+            step.before.turn !== side &&
+            step.move.to === promotionSquare &&
+            step.after.board.get(promotionSquare)?.color === opposite(side)
+        ) {
+            const promotion = step.before.clone();
+            promotion.turn = side;
+            promotion.epSquare = undefined;
+            if (promotion.isLegal({ from: square, to: promotionSquare, promotion: "queen" }))
+                blockadePly = index + 1;
+        }
+        if (blockadePly && step.after.board.get(promotionSquare)?.color !== opposite(side))
+            return null;
+        if (blockadePly && index + 1 >= 7) {
+            through = index + 1;
+            break;
+        }
+    }
+    return through && blockadePly <= 7 ? { through, blockadePly, promotionSquare } : null;
+}
+
+function alternativeKeepsAdvance(steps: TacticalReplayStep[], from: Square, side: Color) {
+    let square = from;
+    for (const step of steps) {
+        if (step.before.turn === side && step.move.from === square) {
+            square = step.move.to;
+            if (step.move.promotion) return true;
+        }
+        const pawn = step.after.board.get(square);
+        if (pawn?.color !== side || pawn.role !== "pawn") return false;
+    }
+    return rank(square, side) >= 7;
+}
+
+function pawnCaptureBranch(
+    fen: string,
+    root: TacticalReplayStep,
+    pawn: Square,
+    replies: readonly DecisionEngineLine[],
+    targeted: readonly DecisionEngineLine[],
+): ExchangePasserEvidence["pawnCapture"] {
+    const best = replies[0];
+    if (best.cp == null) return;
+    const replyFen = makeFen(root.after.toSetup());
+    const comparable = replies.slice(1).filter(reply => reply.depth === best.depth);
+    for (const reply of [...comparable, ...targeted]) {
+        if (
+            reply.depth < 16 || reply.cp == null || reply.mate != null ||
+            best.cp - reply.cp < 100 || reply.pvUci[0] === best.pvUci[0]
+        )
+            continue;
+        const measured = measureDecisionLine(replyFen, reply);
+        if (!measured || measured.drawnEnding) continue;
+        const line = [root.uci, ...reply.pvUci.slice(0, 7)];
+        const steps = replayTacticalLine(fen, line);
+        const [, takePawn, counter, retake, collect, firstQuiet, secondQuiet] = steps;
+        if (
+            !takePawn?.capture || takePawn.move.to !== pawn ||
+            !counter || counter.capture < 300 || counter.move.from !== root.move.to ||
+            !retake?.capture || retake.move.to !== counter.move.to || retake.move.from === pawn ||
+            !collect?.capture || collect.move.to !== pawn || collect.balance < 90 ||
+            !firstQuiet || !secondQuiet ||
+            [firstQuiet, secondQuiet].some(step => step.capture || step.move.promotion || step.after.isCheck())
+        )
+            continue;
+        return {
+            replySan: takePawn.san,
+            lineUci: line.slice(0, 7),
+            description: `Taking the pawn with ${takePawn.san} allows ${counter.san} ${retake.san} ${collect.san}, leaving a gain of ${collect.balance / 100} material points in the analysed line.`,
+        };
+    }
+}
+
+/** A piece offer turns the exact recapturing pawn into a seventh-rank
+ * passer. The opponent commits to a blockade in both searched branches,
+ * and the nearest ranked alternative does not advance that same pawn. */
+export function findExchangePasser(
+    fen: string,
+    line: DecisionEngineLine,
+    candidates: readonly DecisionEngineLine[],
+    replies: readonly DecisionEngineLine[],
+    targeted: readonly DecisionEngineLine[] = [],
+): ExchangePasserEvidence | null {
+    const bestReply = replies[0];
+    const alternative = candidates[1];
+    if (
+        line.pvUci[0] !== candidates[0]?.pvUci[0] ||
+        !bestReply || !alternative || alternative.pvUci[0] === line.pvUci[0] ||
+        line.depth < 16 || bestReply.depth < 16 || line.depth !== alternative.depth ||
+        line.cp == null || alternative.cp == null ||
+        line.mate != null || alternative.mate != null ||
+        bestReply.cp == null || bestReply.mate != null
+    )
+        return null;
+    const confirmedAdvantage = Math.min(line.cp, -bestReply.cp);
+    if (confirmedAdvantage < -35 || confirmedAdvantage - alternative.cp < 90) return null;
+    const [first, answer, recapture] = line.pvUci;
+    if (!answer || !recapture || first.slice(2, 4) !== answer.slice(2, 4) ||
+        first.slice(2, 4) !== recapture.slice(2, 4) ||
+        bestReply.pvUci[0] !== answer || bestReply.pvUci[1] !== recapture)
+        return null;
+    const steps = replayTacticalLine(fen, line.pvUci.slice(0, HORIZON));
+    const [root, defence, retake] = steps;
+    if (!root || !defence?.capture || !retake?.capture) return null;
+    const side = root.before.turn;
+    const dest = root.move.to;
+    const pawn = retake.move.from;
+    const offer = root.before.board.get(root.move.from);
+    if (
+        !offer || offer.role === "king" || offer.role === "pawn" ||
+        defence.move.to !== dest || retake.move.to !== dest ||
+        retake.before.board.get(pawn)?.role !== "pawn" || rank(dest, side) !== 7 ||
+        retake.balance > 100 || retake.balance - root.balance > 50 ||
+        bestReply.pvUci[0] !== defence.uci || bestReply.pvUci[1] !== retake.uci
+    )
+        return null;
+    const principal = measureDecisionLine(fen, line);
+    const separate = measureDecisionLine(makeFen(root.after.toSetup()), bestReply);
+    const control = measureDecisionLine(fen, alternative);
+    if (!principal || !separate || !control || principal.drawnEnding || separate.drawnEnding || control.drawnEnding)
+        return null;
+    const second = replayTacticalLine(fen, [root.uci, ...bestReply.pvUci.slice(0, HORIZON - 1)]);
+    const a = blockadedPasser(steps, dest, side);
+    const b = blockadedPasser(second, dest, side);
+    if (!a || !b) return null;
+    const alternateSteps = replayTacticalLine(fen, alternative.pvUci.slice(0, HORIZON));
+    if (alternateSteps.length < 7 || alternativeKeepsAdvance(alternateSteps.slice(0, 7), pawn, side))
+        return null;
+    const from = makeSquare(pawn);
+    const to = makeSquare(dest);
+    const promotion = makeSquare(a.promotionSquare);
+    const block = steps[a.blockadePly - 1].san;
+    return {
+        fen,
+        factor: {
+            feature: "passed-pawn-progress",
+            side,
+            squareOrFile: to,
+            description: `${root.san} ${defence.san} ${retake.san} brings the pawn from ${from} to ${to}. ${block} blocks its promotion square on ${promotion}, and the pawn stays on the seventh rank in both searches.`,
+            before: rank(pawn, side),
+            after: 7,
+            unit: "relative-rank",
+            firstPly: 3,
+            lastConsecutivePly: Math.min(a.through, b.through),
+            support: "board-fact",
+            comparisonMoveUci: alternative.pvUci[0],
+            comparisonGapCp: line.cp - alternative.cp,
+            supportInComparison: false,
+            comparison: "alternative-choice",
+            materialWindowPlies: 7,
+            interpretation: "heuristic",
+        },
+        pawnFrom: from,
+        pawnTo: to,
+        promotionSquare: promotion,
+        materialBalancePoints: retake.balance / 100,
+        principalLineUci: steps.slice(0, a.through).map(step => step.uci),
+        alternativeLineUci: alternateSteps.slice(0, 7).map(step => step.uci),
+        pawnCapture: pawnCaptureBranch(fen, root, pawn, replies, targeted),
+    };
+}
+
+/** Only verified exchanges earn an additional reply nomination. Reuse moves
+ * that were already searched, and limit the remaining work to two captures. */
+export function nominateExchangePasserCaptures(
+    fen: string,
+    candidates: readonly DecisionEngineLine[],
+    replies: readonly DecisionEngineLine[],
+): string[] {
+    const root = candidates[0];
+    if (!root) return [];
+    const proof = findExchangePasser(fen, root, candidates, replies);
+    if (!proof || proof.pawnCapture) return [];
+    const pawn = parseSquare(proof.pawnFrom);
+    const step = replayTacticalLine(fen, root.pvUci.slice(0, 1))[0];
+    if (pawn === undefined || !step) return [];
+    const searched = new Set(replies.map(reply => reply.pvUci[0]));
+    return [...step.after.allDests()]
+        .filter(([, targets]) => targets.has(pawn))
+        .map(([from]) => makeUci({ from, to: pawn }))
+        .filter(uci => !searched.has(uci))
+        .slice(0, 2);
+}
