+} from "./tacticalSequenceEvidence";
@@ -248,0 +252,42 @@ export function compareExposedPieceTrap(
+function checkingRecaptureContrast(
+    played: DecisionEngineLine,
+    opponent: DecisionEngineLine,
+    actual: TacticalReplayStep,
+    choice: TacticalReplayStep,
+) {
+    const opening = opponent.pvUci.slice(0, 5);
+    if (
+        opening.length !== 5 ||
+        [0, 1, 2, 4].some((index) => opening[index] !== played.pvUci[index + 1])
+    )
+        return null;
+    const fen = makeFen(actual.after.toSetup());
+    const actualExchange = replayTacticalLine(fen, opening.slice(0, 3));
+    const controlExchange = replayTacticalLine(
+        makeFen(choice.after.toSetup()),
+        opening.slice(0, 3),
+    );
+    if (
+        actualExchange.length !== 3 ||
+        controlExchange.length !== 3 ||
+        !actualExchange[1].capture ||
+        !controlExchange[1].capture ||
+        actualExchange[1].capture !== controlExchange[1].capture ||
+        !actualExchange[2].after.isCheck() ||
+        controlExchange[2].after.isCheck()
+    )
+        return null;
+    const witness = (pvUci: string[]) =>
+        extractTacticalSequenceWitnesses(fen, { ...opponent, pvUci }).find(
+            (item) => item.mechanism === "intermezzo" && item.mechanismPly === 3,
+        );
+    const observed = witness(opening);
+    if (!observed || !witness(played.pvUci.slice(1, 6))) return null;
+    return {
+        witness: observed,
+        captureUci: opening[1],
+        checkUci: opening[2],
+        checkSan: actualExchange[2].san,
+    };
+}
