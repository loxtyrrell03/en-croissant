+function removalTrade(steps: TacticalReplayStep[], i: number, square: Square): Trade | undefined {
+    const take = steps[i];
+    const retake = immediateCapture(steps, i, square);
+    const role = take.after.board.get(square)?.role;
+    if (
+        !retake ||
+        !role ||
+        role === "pawn" ||
+        role === "king" ||
+        !steps[i + 2] ||
+        immediateCapture(steps, i + 1, square)
+    )
+        return undefined;
+    return {
+        role,
+        through: i + 2,
+        description: `${take.san} ${retake.san} costs ${sideName(take.before.turn)} a ${role} to stop the pawn`,
+    };
