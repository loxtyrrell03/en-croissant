+import { expect, test } from "vitest";
+import type { DecisionEngineLine } from "../tacticalMotifs/decisionEvidence";
+import { findAdvancedPasserPlan } from "../tacticalMotifs/decisionPasserPlans";
+import { assessChessDecision } from "../tacticalMotifs/decisionAssessment";
+
+const line = (fen: string, cp: number, moves: string): DecisionEngineLine => ({
+    fen,
+    cp,
+    depth: 20,
+    pvUci: moves.split(" "),
+});
+
+const d7 = "2Qr4/3P1pkp/pq4p1/2R5/P7/7P/6P1/1R5K b - - 0 33";
+const blockade = line(d7, -220, "b6b1 c5c1 b1b6 c1e1 b6f6 c8c7 g7f8 e1e3");
+const promotion = line(d7, -886, "b6f6 b1d1 f6e7 c8d8 e7d8 c5c8 d8e7 d7d8q");
+
+test("separates the retained blockade from a concrete promotion after a different choice", () => {
+    const report = assessChessDecision({ fen: d7, candidates: [blockade, promotion] });
+    expect(report?.position.positional.support).toBe("supported");
+    expect(report?.position.strategicPlan).toMatchObject({
+        linesUci: [blockade.pvUci, promotion.pvUci],
+        description: expect.stringMatching(
+            /rook on d8 keeps the d7 passer.*Qxd8 ends.*d8=Q promotes/,
+        ),
+    });
+    expect(report?.mistake).toBeNull();
+});
+
+test("requires observing the same pawn promote or be captured", () => {
+    expect(
+        findAdvancedPasserPlan(d7, [
+            blockade,
+            { ...promotion, pvUci: promotion.pvUci.slice(0, 7) },
+        ]),
+    ).toBeNull();
+    expect(findAdvancedPasserPlan(d7, [blockade, { ...promotion, depth: 19 }])).toBeNull();
+});
+
+test("shows when a check buys time to defend the passed pawn from a rook", () => {
+    const fen = "4k3/8/8/8/P2KP1R1/r7/8/8 w - - 3 51";
+    const preferred = line(fen, 445, "g4g8 e8d7 g8a8 d7c6 a8a5 c6b6 a5b5 b6c6");
+    const loss = line(fen, 29, "d4d5 a3a4 g4g7 e8f8 g7c7 a4a5 d5d6");
+    expect(findAdvancedPasserPlan(fen, [preferred, loss])?.description).toMatch(
+        /After Rg8\+, Ra8 puts a rook.*recapture on a4.*After Kd5, Rxa4/,
+    );
+    expect(
+        findAdvancedPasserPlan(fen, [{ ...preferred, pvUci: preferred.pvUci.slice(0, 4) }, loss]),
+    ).toBeNull();
+});
+
+test("compares a persistent blockade with different safe ways to remove the pawn", () => {
+    const fen = "r5k1/P7/4p3/1Np1P3/2P5/1P1n2K1/8/8 b - - 0 41";
+    const slower = line(fen, 609, "g8f7 g3f3 f7e7 f3e4 d3b4 e4f4 b4c6 b5d6 a8f8 f4e3 c6a7");
+    const earlier = line(fen, 575, "g8f8 b5c7 a8a7 c7e6 f8e7 e6c5 d3c5 g3f3");
+    expect(findAdvancedPasserPlan(fen, [slower, earlier])?.description).toMatch(
+        /rook on a8 blockades the passed pawn on a7.*Nxa7.*Rxa7/,
+    );
+});
+
+test("shows when the same queen is committed to a promotion exchange in two plans", () => {
+    const fen = "8/1P3pk1/1q2p1pp/8/8/4PB1P/5PP1/3R2K1 b - - 2 45";
+    const a = line(
+        fen,
+        -820,
+        "g6g5 d1c1 f7f5 c1c8 g5g4 h3g4 f5g4 f3e4 g4g3 b7b8q g3f2 g1f1 b6b8 c8b8",
+    );
+    const b = line(fen, -832, "f7f5 d1c1 g6g5 c1c8 g5g4 h3g4 f5g4 f3e4 g4g3 b7b8q b6b8 c8b8");
+    expect(findAdvancedPasserPlan(fen, [a, b])?.description).toMatch(
+        /queen stays on b6.*b8=Q.*Qxb8.*Rxb8/,
+    );
+    expect(findAdvancedPasserPlan(fen, [a, { ...b, pvUci: b.pvUci.slice(0, 11) }])).toBeNull();
+});
