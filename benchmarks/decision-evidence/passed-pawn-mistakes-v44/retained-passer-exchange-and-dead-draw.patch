+import { makeFen, parseFen } from "chessops/fen";
+import type { Color, Square } from "chessops/types";
+import { makeSquare, opposite, parseSquare } from "chessops/util";
+import { replayTacticalLine, type TacticalReplayStep } from "./causalTactics";
+import { measureDecisionLine, type DecisionEngineLine } from "./decisionEvidence";
+import { traceAdvancedPawn } from "./decisionPromotionPressure";
+import { extractPositionalBoardFacts } from "./positionalEvidence";
+import type { ComparativePositionalEvidence } from "./positionalTransitions";
+
+const WINDOW = 12;
+const rank = (square: Square, side: Color) =>
+    side === "white" ? 1 + (square >> 3) : 8 - (square >> 3);
+
+export type ExistingPasserEvidence = {
+    factor: ComparativePositionalEvidence;
+    betterLineUci: string[];
+    playedLineUci: string[];
+};
+
+function checkedPaths(fen: string, root: DecisionEngineLine, reply: DecisionEngineLine) {
+    const prefix = replayTacticalLine(fen, root.pvUci.slice(0, 1))[0];
+    if (
+        !prefix ||
+        !measureDecisionLine(fen, root) ||
+        !measureDecisionLine(makeFen(prefix.after.toSetup()), reply)
+    )
+        return [];
+    return [root.pvUci, [prefix.uci, ...reply.pvUci]].map((moves) =>
+        replayTacticalLine(fen, moves.slice(0, WINDOW)),
+    );
+}
+
+function removedByRootPiece(steps: TacticalReplayStep[], index: number) {
+    const mover = steps[0].before.turn;
+    const piece = steps[0].before.board.get(steps[0].move.from)!;
+    let square = steps[0].move.from;
+    for (const step of steps.slice(0, index)) {
+        if (step.before.turn === mover && step.move.from === square) square = step.move.to;
+        const occupant = step.after.board.get(square);
+        if (occupant?.role !== piece.role || occupant.color !== mover) return false;
+    }
+    return steps[index].before.turn === mover && steps[index].move.from === square;
+}
+
+function removalExchange(steps: TacticalReplayStep[], capturePly: number) {
+    const first = steps[capturePly - 1];
+    const target = first.move.to;
+    let end = capturePly;
+    while (steps[end]?.capture && steps[end].move.to === target && !steps[end].move.promotion)
+        end++;
+    const settled = steps[end - 1];
+    const after = steps.slice(end, end + 2);
+    if (
+        !settled.after.isEnd() &&
+        (after.length !== 2 || after.some((step) => step.balance !== settled.balance))
+    )
+        return;
+    return {
+        end,
+        relativeMaterialCp: settled.balance - (steps[capturePly - 2]?.balance ?? 0),
+        san: steps
+            .slice(capturePly - 1, end)
+            .map((step) => step.san)
+            .join(" "),
+    };
+}
+
+function comparePawn(
+    reactions: TacticalReplayStep[][],
+    paths: TacticalReplayStep[][],
+    origin: Square,
+    side: Color,
+) {
+    const better = reactions.map((steps) => traceAdvancedPawn(steps, origin, side));
+    const taken = better.map((trace) => trace.removes?.through ?? 0);
+    if (
+        taken.some(
+            (ply, index) => ply < 1 || ply > 5 || !removedByRootPiece(reactions[index], ply - 1),
+        )
+    )
+        return;
+    const cleaner = reactions.map((steps, index) => removalExchange(steps, taken[index]));
+    if (cleaner.some((item) => !item || item.relativeMaterialCp < 0)) return;
+    const settled = cleaner[0]!;
+    const horizon = Math.max(6, ...taken.map((ply) => ply + 3));
+    if (paths.some((steps) => steps.length < horizon)) return;
+    const active = paths.map((steps) => traceAdvancedPawn(steps.slice(0, horizon), origin, side));
+    if (
+        active.every((trace, index) => {
+            if (trace.removes || trace.promotion) return false;
+            const end = paths[index][horizon - 1].after;
+            const fact = extractPositionalBoardFacts(makeFen(end.toSetup()));
+            return fact?.[side].passedPawns.includes(makeSquare(trace.lastSquare));
+        })
+    ) {
+        return {
+            betterEnd: settled.end,
+            playedEnd: horizon,
+            consequence: `the pawn remains a passer through ${paths[0][horizon - 1].san} in the displayed line and through the same point in the separate search`,
+            removal: settled.san,
+        };
+    }
+    // A pawn can be gone in both continuations and still constrain the
+    // defence. Compare the exchange used to take it in each branch.
+    const captured = active[0].removes;
+    const square = active[0].lastSquare;
+    if (
+        !captured ||
+        rank(square, side) !== 7 ||
+        active.some((trace) => !trace.removes || trace.lastSquare !== square)
+    )
+        return;
+    const exchanges = paths.map((steps, index) =>
+        removalExchange(steps, active[index].removes!.through),
+    );
+    if (exchanges.some((exchange) => !exchange || exchange.relativeMaterialCp > -50)) return;
+    const differences = cleaner.map(
+        (exchange, index) => exchange!.relativeMaterialCp - exchanges[index]!.relativeMaterialCp,
+    );
+    const difference = Math.min(...differences);
+    if (difference < 90) return;
+    return {
+        betterEnd: settled.end,
+        playedEnd: exchanges[0]!.end,
+        consequence: `dealing with the passer on ${makeSquare(square)} costs at least ${(difference / 100).toFixed(1)} more material points in each search. The played line has ${exchanges[0]!.san}`,
+        removal: settled.san,
+    };
+}
+
+/** Direct removal of the same advanced passer, confirmed in both searches.
+ * It must be the piece repositioned by the better move that takes the pawn.
+ * Merely surviving a capture elsewhere is insufficient evidence. */
+export function compareExistingPasser(
+    fen: string,
+    better: DecisionEngineLine,
+    played: DecisionEngineLine,
+    betterReply: DecisionEngineLine,
+    playedReply: DecisionEngineLine,
+): ExistingPasserEvidence | null {
+    if (
+        better.cp === null ||
+        played.cp === null ||
+        better.mate != null ||
+        played.mate != null ||
+        betterReply.cp === null ||
+        playedReply.cp === null ||
+        betterReply.mate != null ||
+        playedReply.mate != null ||
+        better.depth !== played.depth ||
+        better.pvUci[0] === played.pvUci[0] ||
+        better.cp - played.cp < 100 ||
+        playedReply.cp - betterReply.cp < 70 ||
+        Math.abs(better.cp + betterReply.cp) > 90 ||
+        Math.abs(played.cp + playedReply.cp) > 90
+    )
+        return null;
+    const facts = extractPositionalBoardFacts(fen);
+    const setup = parseFen(fen);
+    if (!facts || setup.isErr) return null;
+    const side = opposite(setup.value.turn);
+    const pawns = facts[side].passedPawns
+        .map((square) => parseSquare(square)!)
+        .filter((square) => rank(square, side) >= 5);
+    if (!pawns.length) return null;
+    const preferred = checkedPaths(fen, better, betterReply);
+    const actual = checkedPaths(fen, played, playedReply);
+    if (preferred.length !== 2 || actual.length !== 2) return null;
+    for (const pawn of pawns) {
+        const effect = comparePawn(preferred, actual, pawn, side);
+        if (!effect) continue;
+        const origin = makeSquare(pawn);
+        const rootSan = preferred[0][0].san;
+        const neutralization = effect.removal.startsWith(rootSan)
+            ? effect.removal
+            : `After ${rootSan}, ${effect.removal}`;
+        return {
+            factor: {
+                feature: "passed-pawn",
+                side,
+                squareOrFile: origin[0],
+                description: `After ${actual[0][0].san}, ${effect.consequence}. ${neutralization} removes the same pawn from ${origin} in the better line.`,
+                firstPly: 1,
+                lastConsecutivePly: effect.playedEnd,
+                support: "board-fact",
+                comparisonMoveUci: better.pvUci[0],
+                comparisonGapCp: better.cp - played.cp,
+                supportInComparison: false,
+                comparison: "alternative-choice",
+                interpretation: "heuristic",
+            },
+            betterLineUci: preferred[0].slice(0, effect.betterEnd).map((step) => step.uci),
+            playedLineUci: actual[0].slice(0, effect.playedEnd).map((step) => step.uci),
+        };
+    }
+    return null;
+}
