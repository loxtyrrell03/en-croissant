+import { compareExistingPasser } from "../tacticalMotifs/decisionExistingPasser";
+
+const line = (fen: string, cp: number, moves: string): DecisionEngineLine => ({
+    fen,
+    cp,
+    depth: 20,
+    pvUci: moves.split(" "),
+});
+const board = "8/5rb1/P1N1r1k1/8/6p1/1P1Kp1P1/8/2R1R3 w - - 1 53";
+const best = line(board, 553, "e1e3 e6d6 d3e2 f7f8 e3e4 g7h6 c1c2 g6f5");
+const played = line(board, 369, "c1c5 g7f8 c5c4 f7d7 d3c3 f8g7 c3b4 g7f8");
+const bestReply = line(
+    "8/5rb1/P1N1r1k1/8/6p1/1P1KR1P1/8/2R5 b - - 0 53",
+    -541,
+    "e6d6 d3e2 f7f8 e3e4 g7h6 c1c2 g6f5",
+);
+const playedReply = line(
+    "8/5rb1/P1N1r1k1/2R5/6p1/1P1Kp1P1/8/4R3 b - - 2 53",
+    -396,
+    "g7f8 c5c4 f7d7 d3c3 d7d2 e1e3 e6e3 c3d2",
+);
+
+describe("existing passed pawns in an assessed mistake", () => {
+    it("confirms that the actual choice leaves the same advanced passer in both searches", () => {
+        const evidence = compareExistingPasser(board, best, played, bestReply, playedReply);
+        expect(evidence?.factor.description).toContain("Rxe3 removes the same pawn from e3");
+        expect(evidence?.factor.description).toContain("the pawn remains a passer");
+        expect(evidence?.playedLineUci).toHaveLength(6);
+        expect(evidence?.betterLineUci).toEqual(["e1e3"]);
+    });
+
+    it("requires an independently measured deterioration and both exact child frames", () => {
+        expect(compareExistingPasser(board, best, played, bestReply, bestReply)).toBeNull();
+        expect(
+            compareExistingPasser(board, best, played, bestReply, { ...playedReply, cp: -515 }),
+        ).toBeNull();
+    });
+
+    it("recognises the cost of taking the same pawn after it advances to the seventh rank", () => {
+        const fen = "8/1p3pkp/8/3Pr1p1/p1q1Pb2/P2p3P/1P3QP1/3RR2K w - - 2 43";
+        const neutralizes = line(fen, 532, "f2f1 e5e7 f1d3 c4d3 d1d3 f7f6 b2b3 a4b3");
+        const allows = line(fen, 95, "g2g3 d3d2 d1d2 f4d2 f2d2 g7f8 d2e3 f7f6");
+        const neutralizesReply = line(
+            "8/1p3pkp/8/3Pr1p1/p1q1Pb2/P2p3P/1P4P1/3RRQ1K b - - 3 43",
+            -570,
+            "e5e7 f1d3 c4d3 d1d3 f7f6 b2b3 a4b3",
+        );
+        const allowsReply = line(
+            "8/1p3pkp/8/3Pr1p1/p1q1Pb2/P2p2PP/1P3Q2/3RR2K b - - 0 43",
+            -87,
+            "d3d2 d1d2 f4d2 f2d2 g7f8 d2e3 f7f6",
+        );
+        const evidence = compareExistingPasser(
+            fen,
+            neutralizes,
+            allows,
+            neutralizesReply,
+            allowsReply,
+        );
+        expect(evidence?.factor.description).toContain("Rxd2 Bxd2 Qxd2");
+        expect(evidence?.factor.description).toContain("1.7 more material points");
+    });
+
+    it("can assess an exact better choice whose scored line reaches bare kings", () => {
+        const fen = "5n2/1k4p1/2P3p1/8/R2N3r/2K5/8/8 b - - 0 51";
+        const drawing = line(
+            fen,
+            -27,
+            "b7c7 d4b5 c7c6 b5a7 c6b7 a4h4 b7a7 h4f4 f8e6 f4e4 e6c7 c3c4 a7b6 e4g4 b6c6 g4g6 c6d7 c4d4 c7e6 d4e5 e6c7 g6g7 d7c6 g7c7 c6c7 e5e6",
+        );
+        const worse = line(fen, -404, "b7b8 a4b4 b8c8 b4b7 h4h1 b7e7 f8h7 d4b5");
+        const drawingReply = line(
+            "5n2/2k3p1/2P3p1/8/R2N3r/2K5/8/8 w - - 1 52",
