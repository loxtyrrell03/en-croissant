+/** Show how a newly deployed rook gains a lasting post through an equal
+ * minor-piece exchange. The other search must retain the same rook and file. */
+export function findRookRecapturePlan(
+    fen: string,
+    main: DecisionEngineLine,
+    confirmedReply: DecisionEngineLine,
+): PositionStrategicPlan | null {
+    const steps = replayTacticalLine(fen, main.pvUci.slice(0, WINDOW));
+    const [root] = steps;
+    if (!root || root.capture || root.before.isCheck() || root.after.isCheck()) return null;
+    const side = root.before.turn;
+    const castle = castlingSide(root.before, root.move);
+    if (!castle && root.before.board.get(root.move.from)?.role !== "rook") return null;
+    const entry = castle ? rookCastlesTo(side, castle) : root.move.to;
+    const column = file(entry);
+    const keepsFile = (board: Chess, square: Square) =>
+        file(square) === column && openForRook(board, square, side);
+    if (
+        !keepsFile(root.after, entry) ||
+        [...root.before.board.rook.intersect(root.before.board[side])].some(
+            (rook) => file(rook) === column,
+        )
+    )
+        return null;
+
+    const isMinor = (value: number) => value === 320 || value === 330;
+    let square = entry;
+    for (let i = 1; i <= Math.min(6, steps.length - 4); i++) {
+        const step = steps[i];
+        if (!keepsFile(step.before, square)) return null;
+        if (step.before.turn !== side && step.capture && step.move.to === square) return null;
+        if (step.before.turn !== side || step.move.from !== square) continue;
+        square = step.move.to;
+        if (!keepsFile(step.after, square)) return null;
+        if (!step.capture) continue;
+        const previous = steps[i - 1];
+        if (
+            rank(square, side) < 5 ||
+            step.after.isCheck() ||
+            !isMinor(previous.capture) ||
+            !isMinor(step.capture) ||
+            previous.move.to !== square ||
+            Math.abs(step.balance - (steps[i - 2]?.balance ?? 0)) > 50
+        )
+            return null;
+        const through = i + 4;
+        const settle = steps.slice(i + 1, through);
+        if (
+            settle.some(
+                (later) =>
+                    !keepsFile(later.after, square) ||
+                    later.after.board.get(square)?.role !== "rook" ||
+                    later.after.board.get(square)?.color !== side ||
+                    Math.abs(later.balance - step.balance) > 50,
+            )
+        )
+            return null;
+        const otherUci = [root.uci, ...confirmedReply.pvUci].slice(0, through);
+        const corroboration = measureDecisionLine(
+            makeFen(root.after.toSetup()),
+            confirmedReply,
+        );
+        if (otherUci.length < through || !corroboration || corroboration.drawnEnding) return null;
+        const other = replayTacticalLine(fen, otherUci);
+        if (maintain(other, 0, entry, keepsFile) < through) return null;
+        return {
+            linesUci: [main.pvUci.slice(0, through), otherUci],
+            description: `${root.san} places a rook on ${makeSquare(entry)}. The exchange ${previous.san} ${step.san} brings that rook to ${makeSquare(square)}, where it stays through ${settle[2].san}. The separate reply search also keeps the rook on the ${makeSquare(entry)[0]}-file.`,
+        };
+    }
+    return null;
+}
