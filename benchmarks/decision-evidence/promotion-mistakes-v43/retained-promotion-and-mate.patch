+function takesNewPiece(
+    steps: TacticalReplayStep[],
+    trace: ReturnType<typeof traceAdvancedPawn>,
+    target: Square,
+) {
+    const event = trace.promotion;
+    if (event?.square !== target || event.trade?.role === "queen") return;
+    const take = steps[event.through];
+    const reply = steps[event.through + 1];
+    if (
+        !take?.capture ||
+        take.move.to !== target ||
+        !reply ||
+        (reply.move.to === target && reply.capture && !event.trade)
+    )
+        return;
+    return {
+        through: event.trade?.through ?? event.through + 1,
+        contextThrough: event.trade?.through ?? event.through + 1,
+        description: `${take.san} takes the promoted piece${event.trade ? ` before ${steps[event.trade.through - 1].san}` : ""}`,
+    };
+}
+
+/** Test each legal straight promotion. A rook behind a pawn helps only if
+ * it can legally and profitably take the new piece even after underpromotion. */
+function rookCoversPromotion(board: Chess, pawn: Square, target: Square, rook: Square) {
+    if ((rook & 7) !== (target & 7) || !board.board.rook.has(rook)) return false;
+    let tested = false;
+    for (const promotion of PROMOTION_ROLES) {
+        const move = { from: pawn, to: target, promotion };
+        if (!board.isLegal(move)) continue;
+        tested = true;
+        const promoted = board.clone();
+        promoted.play(move);
+        const capture = { from: rook, to: target };
+        if (!promoted.isLegal(capture) || tacticalExchangeGain(promoted, capture) < 90)
+            return false;
+    }
+    return tested ? true : undefined;
+}
+
+function repeatedRookGuard(
+    steps: TacticalReplayStep[],
+    pawn: Square,
+    target: Square,
+    opponent: Color,
+) {
+    if (target !== pawn + (opponent === "white" ? 8 : -8) || !steps.length) return;
+    const board = steps[0].after;
+    const defender = opposite(opponent);
+    for (const rook of board.board.rook.intersect(board.board[defender])) {
+        if (!rookCoversPromotion(board, pawn, target, rook)) continue;
+        for (let i = 1; i < steps.length; i++) {
+            const step = steps[i];
+            if (
+                (step.before.turn === defender && step.move.from === rook) ||
+                (step.before.turn === opponent && step.move.from === pawn) ||
+                !step.after.board.pawn.has(pawn) ||
+                !step.after.board[opponent].has(pawn) ||
+                !step.after.board.rook.has(rook) ||
+                !step.after.board[defender].has(rook)
+            )
+                break;
+            if (step.after.turn === opponent) {
+                const covered = rookCoversPromotion(step.after, pawn, target, rook);
+                if (covered === undefined) continue;
+                if (!covered) break;
+                return {
+                    rook,
+                    through: i + 1,
+                    contextThrough: i + 1,
+                    description: `the rook on ${makeSquare(rook)} can capture any straight promotion on ${makeSquare(target)} in the checked positions`,
+                };
+            }
+        }
+    }
