{
  "bundle": {
    "active": true,
    "category": "BoardGame",
    "copyright": "",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "publisher": "Francisco Salgueiro",
    "shortDescription": "Ultimate Chess Toolkit",
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": {
      "../sound/": "sound/",
      "../licenses/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "targets": "all"
  },
  "build": {
    "beforeDevCommand": "npm run start-vite",
    "beforeBuildCommand": "node scripts/verify-compression-notices.mjs && npm run build-vite",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "productName": "en-croissant-fork",
  "mainBinaryName": "en-croissant-fork",
  "identifier": "org.encroissant.app",
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "En Croissant Fork",
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}
