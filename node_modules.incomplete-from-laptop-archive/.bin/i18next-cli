else
  export NODE_PATH="/mnt/c/Users/loxty/Desktop/Repos/En croissant chess/node_modules/.pnpm/i18next-cli@1.42.12_i18next_31b6f1fee80b0a8697f445605b6cbdac/node_modules/i18next-cli/node_modules:/mnt/c/Users/loxty/Desktop/Repos/En croissant chess/node_modules/.pnpm/i18next-cli@1.42.12_i18next_31b6f1fee80b0a8697f445605b6cbdac/node_modules:/mnt/c/Users/loxty/Desktop/Repos/En croissant chess/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../i18next-cli/dist/esm/cli.js" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../i18next-cli/dist/esm/cli.js" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../i18next-cli/dist/esm/cli.js" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../i18next-cli/dist/esm/cli.js" "$@"
